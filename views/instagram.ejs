<%- include("includes/head.ejs")%>

    <body>
        <h1>This is instagram page </h1>
        <div>
            <h3> Username :
                @<%= data.name %>
            </h3>

            <button>Follow</button>
            <button>Message</button>


            <p>Followers:- <%= data.followers%>
            </p>
            <p>Following:- <%= data.following%>
            </p>

            <hr>


            <% for (let post of data.posts) {%>
                <img src="<%= post.image %>" alt="some image">

                <p>Likes:- <%= post.likes%>
                </p>
                <p>comment:- <%= post.comments%>
                </p>
                <%}%>
        </div>
        <%- include("footer/footer.ejs")%>
            <script src="/app.js"></script>
    </body>

    </html>