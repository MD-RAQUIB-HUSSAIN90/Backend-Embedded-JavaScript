<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>This is instagram page </h1>
    <div>
        <h3> Username :
            @<%= username %>

        </h3>
        <div class="buttons">
            <button>Follow</button>
            <button>Unfollow</button>
            <button>Massege</button>
        </div>
        <div style="display: flex; justify-content: space-between;width: 30%;">
            <p>Likes </p>
            <p>Comments</p>
            <p>Share</p>
        </div>
        <div>
            <h3>Account that follow you :</h3>
            <ul>
                <% for (let name of followers){ %>
                    <li>
                        <%=name%>
                    </li>
                    <%} %>
            </ul>
        </div>
    </div>
</body>

</html>