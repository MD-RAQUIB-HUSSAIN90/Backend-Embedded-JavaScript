<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        img{
            height: 100px;
            width: 100px;
        }
    </style>
</head>

<body>
    <h1>This is instagram page </h1>
    <div>
        <h3> Username :
            @<%= data.name %>
        </h3>
        <p>Followers:- <%= data.followers%>
        </p>
        <p>Following:- <%= data.following%>
        </p>

        <hr>


        <% for (let post of data.posts) {%>
            <img src="<%= post.image %>" alt="some image">

            <p>Likes:- <%= post.likes%>
            </p>
            <p>comment:- <%= post.comments%>
            </p>
            <%}%>
    </div>
</body>

</html>


